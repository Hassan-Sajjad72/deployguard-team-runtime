# Images are built externally from frozen DeployGuard Test 2 SHA
# 12ed47797fe82bee1bdec449936e57d7c27758e4. They do not require any
# modification to the frozen DeployGuard Test 2 or Test 3 repositories.
DEPLOYGUARD_BACKEND_IMAGE=ghcr.io/hassan-sajjad72/deployguard-team-runtime-backend:test2-12ed477-runtime-1
DEPLOYGUARD_FRONTEND_IMAGE=ghcr.io/hassan-sajjad72/deployguard-team-runtime-frontend:test2-12ed477-runtime-1

# Host/browser ports. Containers communicate only with Docker service names.
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=5000
POSTGRES_HOST_PORT=5433
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# Required base-runtime secrets: replace every CHANGE_ME value before startup.
POSTGRES_DB=mini_paas
POSTGRES_USER=mini_paas_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password_at_least_16_characters
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters
AUTH_SESSION_SECRET=CHANGE_ME_auth_session_secret_at_least_32_characters
SESSION_SECRET=CHANGE_ME_session_secret_at_least_32_characters
PROMETHEUS_SCRAPE_TOKEN=CHANGE_ME_prometheus_token_at_least_32_characters
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password_at_least_16_characters

# DeployGuard runtime defaults.
NODE_ENV=production
ALLOW_INSECURE_USER_HEADER=false
TERRAFORM_BIN=terraform
TERRAFORM_AUTO_APPROVE=true
TERRAFORM_APPLY_ENABLED=true
TERRAFORM_APPLY_REQUIRES_APPROVAL=true
FINOPS_MOCK_MODE=true
INFRACOST_ENABLED=false
COST_GATE_MODE=bypass
AWS_RUNTIME_MONITORING_ENABLED=true
PROMETHEUS_ENABLED=true
CLOUDWATCH_LOGS_ENABLED=true
CLOUDWATCH_METRICS_ENABLED=true
STATE_MOCK_MODE=false
TERRAFORM_STATE_USE_LOCKFILE=true

# Fill these when using GitHub login and AWS deployment features.  They are not
# needed merely to bring up the local platform, but a cloud deployment will be
# rejected until its required AWS and GitHub configuration is complete.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
DEPLOYGUARD_REUSABLE_WORKFLOW=Hassan-Sajjad72/Deploy-Guard-dev/.github/workflows/deployguard-reusable.yml@12ed47797fe82bee1bdec449936e57d7c27758e4
DEPLOYGUARD_GITHUB_ACTIONS_ROLE_ARN=
DEPLOYGUARD_GITHUB_ACTIONS_ROLE_MANAGEMENT=external
DEPLOYGUARD_VPC_ID=
DEPLOYGUARD_PUBLIC_SUBNET_IDS=
DEPLOYGUARD_SHARED_ECS_CLUSTER_ARN=
DEPLOYGUARD_SHARED_ECS_CLUSTER_NAME=
DEPLOYGUARD_SHARED_ALB_ARN=
DEPLOYGUARD_SHARED_ALB_DNS_NAME=
DEPLOYGUARD_SHARED_ALB_LISTENER_ARN=
DEPLOYGUARD_SHARED_ALB_SECURITY_GROUP_ID=
DEPLOYGUARD_ROUTING_DOMAIN=
DEPLOYGUARD_TERRAFORM_STATE_BUCKET=
GITHUB_ACTIONS_WORKFLOW_FILE=deployguard.yml
GITHUB_ACTIONS_REQUIRED=false
EXTERNAL_CI_REQUIRED=false
AUTOMATION_MANUAL_APPROVALS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ECR_REPOSITORY_PREFIX=mini-paas
TERRAFORM_STATE_BUCKET=
TERRAFORM_STATE_REGION=us-east-1
TERRAFORM_STATE_PREFIX=projects
